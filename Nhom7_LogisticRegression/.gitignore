# ============================================================
# .gitignore chuẩn cho Python Project
# Mục đích: Loại bỏ các file/folder không cần thiết,
# tránh zip cả thư viện (venv, __pycache__...) lên drive
# ============================================================

# ---------- Byte-compiled / Optimized / DLL files ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- Virtual Environment (THƯ VIỆN PYTHON) ----------
# ĐÂY LÀ THỦ PHẠM CHÍNH GÂY NẶNG FILE (hàng trăm MB - vài GB)
venv/
.venv/
env/
.env/
ENV/
myenv/

# ---------- Distribution / Packaging ----------
dist/
build/
*.egg-info/
*.egg
*.whl

# ---------- Installer logs ----------
pip-log.txt
pip-delete-this-directory.txt

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/

# ---------- OS generated files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Pytest / Coverage ----------
.pytest_cache/
htmlcov/
.coverage
*.cover

# ---------- mypy ----------
.mypy_cache/

# ---------- Logs ----------
*.log

# ---------- Database ----------
*.db
*.sqlite3
